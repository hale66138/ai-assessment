# 复制本文件为 .env.local 并填入真实值（.env.local 不会被提交到 git）
# 在 Supabase 控制台 → Project Settings → API 里可以找到这三项

# Project URL，形如 https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon public key（可公开，用于匿名写入）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role secret key（仅服务端使用，绝不能暴露给浏览器）
SUPABASE_SERVICE_ROLE_KEY=
